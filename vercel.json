{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://padre-ginos-api-ibnz.onrender.com/api/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "https://padre-ginos-api-ibnz.onrender.com/public/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
